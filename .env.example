# ============================================================================
# The Guardian of Kali — Environment Configuration Template
# ============================================================================

# AI Co-Pilot key. The app asks for the Gemini key on first launch and saves it
# here, so this can be left empty. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative: Anthropic Claude (used only when no Gemini key is set).
# ANTHROPIC_API_KEY=

# Only read by the optional /ws/terminal streaming endpoint.
WSL_DISTRO=kali-linux
WSL_USER=root
