# ============================================================================
# The Guardian of Kali — Environment Configuration Template
# ============================================================================

# Anthropic Claude API Key (Required for AI Co-Pilot features)
# Obtain your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Backend Server Configuration
HOST=127.0.0.1
PORT=8765

# WSL2 Execution Configuration
WSL_DISTRO=kali-linux
WSL_USER=ia-user
WSL_TIMEOUT_SECONDS=30.0

# Database Configuration
DATABASE_PATH=the_guardian_of_kali.db
